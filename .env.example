# Copia este archivo a `.env.local` para desarrollo (no se sube a git).

# GitHub Pages / local sin función. En Netlify NO lo pongas: queda en el JS público.
# En Pages puedes usar el secreto de Actions: VITE_GEMINI_API_KEY
VITE_GEMINI_API_KEY=

# Lo rellena netlify.toml en el build de Netlify (`/api/analizar`).
# `npm run dev` ya lo pone. En GitHub Pages déjalo vacío.
# VITE_ANALYZE_API=/api/analizar
